# CSS and JS — short cache so updates show immediately
/assets/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/assets/*.js
  Cache-Control: public, max-age=3600, must-revalidate

# Images and fonts — longer cache is fine (they don't change often)
/assets/fonts/*
  Cache-Control: public, max-age=2592000

/assets/*.png
  Cache-Control: public, max-age=2592000

/assets/*.webp
  Cache-Control: public, max-age=2592000

/assets/*.svg
  Cache-Control: public, max-age=2592000

/assets/*.ico
  Cache-Control: public, max-age=2592000

# HTML pages — short cache
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

/
  Cache-Control: public, max-age=3600, must-revalidate
